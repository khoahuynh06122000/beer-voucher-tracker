rules_version = '2';

// ============================================================================
// KHO CŨ - ĐÃ NGƯNG SỬ DỤNG (dữ liệu chính thức nằm ở Supabase).
//
// CHO ĐỌC  : để còn kéo nốt dữ liệu lịch sử về Supabase.
// CẤM GHI  : app cũ trên AI Studio / Cloud Run nếu còn ai mở sẽ KHÔNG lưu được,
//            báo lỗi ngay tại chỗ thay vì âm thầm ghi vào kho chết.
//            (Đã mất data 04-07/08/2026 vì nhà hàng nhập nhầm ở link cũ.)
//
// Sau khi kéo xong toàn bộ lịch sử, có thể đổi luôn `allow read` thành `if false`.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
